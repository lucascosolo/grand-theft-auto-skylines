<Project Sdk="Microsoft.NET.Sdk">
  <!-- The whole game simulation. BCL only: no Unity, no CS1. Loaded by CS1 (net35) and tested on net10.0. -->
  <PropertyGroup>
    <TargetFrameworks>net35;net10.0</TargetFrameworks>
    <RootNamespace>GtaSkylines.Game</RootNamespace>
    <AssemblyName>GtaSkylines.Game</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GtaSkylines.Game.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Skylines.Core\Skylines.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
