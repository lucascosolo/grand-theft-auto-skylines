<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Mod targets the game's Mono runtime; its Unity-free helpers are compiled in directly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>GtaSkylines.Mod.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\GtaSkylines.Mod\Input\KeyNames.cs" Link="KeyNames.cs" />
    <Compile Include="..\..\src\GtaSkylines.Mod\Input\ButtonMap.cs" Link="ButtonMap.cs" />
    <Compile Include="..\..\src\GtaSkylines.Mod\Options\BindingText.cs" Link="BindingText.cs" />
    <Compile Include="..\..\src\GtaSkylines.Mod\Lifecycle\SimRateSetting.cs" Link="SimRateSetting.cs" />
    <Compile Include="..\..\src\GtaSkylines.Mod\Persistence\ProfileStore.cs" Link="ProfileStore.cs" />
    <Compile Include="..\..\src\GtaSkylines.Mod\Persistence\SettingsFile.cs" Link="SettingsFile.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GtaSkylines.Game\GtaSkylines.Game.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
